# Random 32+ byte secret used to sign the access cookie.
GATE_SECRET=
# The party access code people type at citations.hosaka.xyz.
GATE_ACCESS_CODE=
# Shared workspace. Publishable key only — never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_WORKSPACE_ID=
# Scoped session-store capability, 32 random bytes encoded as 64 hex characters.
# Its SHA-256 hash is registered in the private Supabase session table.
WALL_SESSION_STORE_SECRET=
# Independent random 32-byte key encoded as 64 hex characters; keep private.
WALL_SESSION_ENCRYPTION_KEY=
# Stable project-specific scope; environment is checked against VERCEL_ENV.
WALL_SESSION_SCOPE=citations-gate
WALL_SESSION_ENVIRONMENT=development
# No SUPABASE_REFRESH_TOKEN fallback. Use npm run wall:login privately.
